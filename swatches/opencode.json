{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "blender-agent-bridge": {
      "type": "local",
      "command": ["blender-bridge", "--bridge-url", "http://127.0.0.1:8765"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp", "--headless", "--isolated"],
      "enabled": true
    }
  }
}
