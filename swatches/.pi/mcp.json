{
  "mcpServers": {
    "blender-agent-bridge": {
      "command": "blender-bridge",
      "args": [
        "--bridge-url",
        "http://127.0.0.1:8765"
      ],
      "type": "stdio",
      "enabled": true
    },
    "playwright": {
      "command": "sh",
      "args": [
        "-c",
        "if [ -n \"${HTTPS_PROXY:-}\" ]; then exec playwright-mcp --headless --isolated --proxy-server \"$HTTPS_PROXY\"; else exec playwright-mcp --headless --isolated; fi"
      ],
      "disabled": false,
      "lifecycle": "lazy",
      "directTools": false
    }
  }
}
