@@ -0,0 +1,106 @@
+"""Run only in disposable factory-startup Blender."""
+import hashlib
+import json
+import os
+import sys
+import tempfile
+from unittest import mock
+
+import bpy
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
+sys.path.insert(0, os.path.join(ROOT, "addon"))
+from claude_blender import matched_views
+
+baseline = bpy.data.objects["Cube"]
+vertices = [tuple(vertex.co) for vertex in baseline.data.vertices]
+faces = [tuple(face.vertices) for face in baseline.data.polygons]
+marker = [(x * 0.25 + 1.8, y * 0.25, z * 0.25 + 1.8) for x, y, z in vertices]
+mesh = bpy.data.meshes.new("Asymmetric camera marker")
+mesh.from_pydata(vertices + marker, [], faces + [tuple(index + 8 for index in face) for face in faces])
+baseline.data = mesh
+candidate = baseline.copy()
+candidate.data = baseline.data.copy()
+candidate.name = "../Candidate"
+bpy.context.scene.collection.objects.link(candidate)
+candidate.hide_render = True
+views = [
+    {"position": [0, -6.8, 2.3], "look_at": [0, 0, 0], "projection": "PERSP", "lens": 36, "ortho_scale": 5},
+    {"position": [7, 0, 1], "look_at": [0, 0, 0], "projection": "ORTHO", "lens": 36, "ortho_scale": 5},
+    {"position": [0, -8, 0], "look_at": [0, 0, 0], "projection": "ORTHO", "lens": 36, "ortho_scale": 6},
+]
+profile = {"width": 64, "height": 64, "colour": [0.6, 0.6, 0.6]}
+args = (bpy.context, {"kind": "OBJECT", "name": baseline.name}, {"kind": "OBJECT", "name": candidate.name}, views, profile)
+
+
+def state():
+    scene = bpy.context.scene
+    return {
+        "data": {key: [item.name for item in getattr(bpy.data, key)] for key in ("scenes", "objects", "meshes", "cameras", "lights", "materials", "worlds")},
+        "objects": [(o.name, o.hide_render, o.hide_viewport, o.hide_get(), o.select_get()) for o in scene.objects],
+        "scene": (scene.name, scene.camera.name, scene.render.engine, scene.render.filepath, scene.render.resolution_x, scene.render.resolution_y, scene.render.resolution_percentage),
+        "active": bpy.context.view_layer.objects.active.name,
+    }
+
+
+before = state()
+output = tempfile.mkdtemp(prefix="matched-smoke-")
+with mock.patch.object(matched_views.lab_parity, "_render_root_info", return_value={"render_thumbnail_root": output}):
+    modifier = candidate.modifiers.new("Render only", "SUBSURF")
+    modifier.show_viewport = False
+    modifier.show_render = True
+    rejected = matched_views.capture_matched_views(*args)
+    assert not rejected["ok"] and rejected["code"] == "matched_views_invalid", rejected
+    assert "apply modifiers" in rejected["message"]
+    candidate.modifiers.remove(modifier)
+    result = matched_views.capture_matched_views(*args)
+    assert result["ok"], result
+    assert state() == before, "Source state changed"
+    images = result["manifest"]["images"]
+    def pixels(path):
+        image = bpy.data.images.load(path, check_existing=False)
+        try:
+            assert tuple(image.size) == (64, 64)
+            return tuple(image.pixels)
+        finally:
+            bpy.data.images.remove(image)
+    for index in (0, 2, 4):
+        assert pixels(images[index]["path"]) == pixels(images[index + 1]["path"]), "Matched cameras drifted"
+    orientation = pixels(images[4]["path"])
+    def rgb(x, y):
+        start = (y * 64 + x) * 4
+        return orientation[start:start + 3]
+    assert max(abs(a - b) for a, b in zip(rgb(12, 12), rgb(2, 2))) < 0.02, "Negative X/Z corner must be background"
+    assert max(abs(a - b) for a, b in zip(rgb(51, 51), rgb(2, 2))) > 0.05, "Positive X/Z marker must be at the top right"
+    assert pixels(images[0]["path"]) != pixels(images[2]["path"]), "Views did not change"
+    for image in images:
+        assert os.path.commonpath([output, image["path"]]) == output
+        data = open(image["path"], "rb").read()
+        assert data[:8] == b"\x89PNG\r\n\x1a\n"
+        assert hashlib.sha256(data).hexdigest() == image["sha256"]
+    assert json.load(open(result["manifest_path"]))["images"] == images
+    candidate.scale.x = 1.5
+    bpy.context.view_layer.update()
+    changed = matched_views.capture_matched_views(*args)
+    assert changed["ok"], changed
+    changed_images = changed["manifest"]["images"]
+    assert pixels(changed_images[0]["path"]) != pixels(changed_images[1]["path"]), "Geometry change was not captured"
+    candidate.scale.x = 1
+    bpy.context.view_layer.update()
+    with mock.patch.object(matched_views, "_render", side_effect=RuntimeError("Injected render error")):
+        failed = matched_views.capture_matched_views(*args)
+    assert not failed["ok"], failed
+    assert state() == before, "Render failure changed source state"
+    def cancelled(**kwargs):
+        scene = bpy.data.scenes[kwargs["scene"]]
+        with open(scene.render.filepath, "wb") as handle:
+            handle.write(b"existing PNG")
+        return {"CANCELLED"}
+    from types import SimpleNamespace
+    proxy = SimpleNamespace(data=bpy.data, app=bpy.app, ops=SimpleNamespace(render=SimpleNamespace(render=cancelled)))
+    with mock.patch.object(matched_views, "bpy", proxy):
+        failed = matched_views.capture_matched_views(*args)
+    assert not failed["ok"] and "did not finish" in failed["message"], failed
+    assert not os.path.exists(os.path.join(failed["partial_output_dir"], "manifest.json"))
+    assert state() == before, "Cancelled render changed source state"
+print("MATCHED_VIEWS_SMOKE_OK", result["manifest_path"])
