+        raise ValueError("Save the scene or configure a local GLB import root in Preferences")
+    if _configured_root_binding is None or _configured_root_binding[0] != root:
+        configure_import_root(prefs, context)
+    if _configured_root_binding[1] is None:
+        raise ValueError("Invalid configured import directory")
+    return root, _configured_root_binding[1]
+
