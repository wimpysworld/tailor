+    def test_root_replacement_during_read_is_blocked(self):
+        root = self.root / "project"
+        root.mkdir()
+        (root / "model.glb").write_bytes(glb())
+        self.configure_root(root)
+        original = self.module._open_directory
+        count = 0
+        def replace(path):
