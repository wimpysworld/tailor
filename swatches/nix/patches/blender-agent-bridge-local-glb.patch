+    while pending:
+        value = pending.pop()
+        if isinstance(value, dict):
+            if any(key.lower() == "uri" for key in value):
+                raise ValueError("GLB URI references are blocked; embed all buffers and images")
+            pending.extend(value.values())
+        elif isinstance(value, list):
+            pending.extend(value)
+
