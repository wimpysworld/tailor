+"""Check the built ZIP in disposable Blender without registering the add-on."""
+import json
+import os
+import sys
+import tempfile
+import zipfile
+
+import bpy
+
+archive = sys.argv[sys.argv.index("--") + 1]
+with tempfile.TemporaryDirectory(prefix="packaged-helper-smoke-") as directory:
+    package = os.path.join(directory, "claude_blender")
+    with zipfile.ZipFile(archive) as source:
+        source.extractall(package)
+    sys.path.insert(0, directory)
+    from claude_blender import tool_dispatcher
+    assert "import_local_glb" in tool_dispatcher.TOOL_FUNCTIONS
+    assert "capture_matched_views" in tool_dispatcher.TOOL_FUNCTIONS
+    def call(name, args):
+        return json.loads(tool_dispatcher.execute_tool(bpy.context, name, args))
+    imported = call("import_local_glb", {"relative_path": "missing.glb"})
+    assert not imported["ok"], imported
+    assert "project" in imported.get("code", "") or "save" in imported.get("message", "").lower(), imported
+    captured = call("capture_matched_views", {
+        "baseline": {"kind": "OBJECT", "name": "Missing"},
+        "candidate": {"kind": "OBJECT", "name": "Cube"},
+        "views": [], "profile": {},
+    })
+    assert not captured["ok"] and captured["code"] == "matched_views_invalid", captured
+    missing = call("import_local_glb", {})
+    assert not missing["ok"] and "KeyError" in missing["message"], missing
+print("PACKAGED_HELPERS_SMOKE_OK")
