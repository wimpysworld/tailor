+    identity = []
+    try:
+        for part in parts:
+            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
+            os.close(descriptor)
+            descriptor = child
+            info = os.fstat(descriptor)
+            identity.append((info.st_dev, info.st_ino))
+        return descriptor, tuple(identity)
+    except BaseException:
+        os.close(descriptor)
+        raise
+
+
