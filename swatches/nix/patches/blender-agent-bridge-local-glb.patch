+"""Run in a separate factory-startup Blender, never in the live user scene."""
+import os
+import sys
+import tempfile
+
+import bpy
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
+sys.path.insert(0, os.path.join(ROOT, "addon"))
+from claude_blender import live_preview, local_glb, preferences
+
+bpy.utils.register_class(preferences.CLAUDEBLENDER_AP_preferences)
+addon = bpy.context.preferences.addons.new()
+addon.module = "claude_blender"
+prefs = preferences.get_preferences(bpy.context)
+assert prefs.local_glb_import_root == ""
+assert not bpy.data.filepath
+
+with tempfile.TemporaryDirectory(prefix="local-glb-smoke-", dir=os.path.join(ROOT, "dist")) as directory:
+    bpy.ops.export_scene.gltf(filepath=os.path.join(directory, "cube.glb"), use_selection=True, export_animations=False)
+    assert not local_glb.import_local_glb(bpy.context, "cube.glb")["ok"]
+    prefs.local_glb_import_root = directory
+    assert local_glb._configured_root_binding[1] is not None
+    before_unsaved = {collection: {item.as_pointer() for item in getattr(bpy.data, collection)} for _, collection in local_glb.DATA_KINDS}
+    earlier = live_preview.begin("Unsaved earlier preview", bpy.context)
+    result = local_glb.import_local_glb(bpy.context, "cube.glb")
+    assert result["ok"] and result["preview_pending"], result
+    assert not bpy.data.filepath
+    assert live_preview.current_transaction() is earlier
+    assert live_preview.revert(bpy.context)["ok"]
+    for _, collection in local_glb.DATA_KINDS:
+        assert {item.as_pointer() for item in getattr(bpy.data, collection)} == before_unsaved[collection], collection
+    library = os.path.join(directory, "library.blend")
+    bpy.data.libraries.write(library, {bpy.data.objects["Cube"]})
+    bpy.data.objects.remove(bpy.data.objects["Cube"], do_unlink=True)
+    with bpy.data.libraries.load(library, link=True) as (source, target):
+        target.objects = ["Cube"]
+    linked = target.objects[0]
+    bpy.context.scene.collection.objects.link(linked)
+    linked.select_set(True)
+    bpy.context.view_layer.objects.active = linked
+    bpy.ops.wm.save_as_mainfile(filepath=os.path.join(directory, "test.blend"))
+    prefs.local_glb_import_root = "invalid"
+    before = {collection: {item.as_pointer() for item in getattr(bpy.data, collection)} for _, collection in local_glb.DATA_KINDS}
+    selected = {item.name for item in bpy.context.selected_objects}
+    active = bpy.context.view_layer.objects.active.name
+    bpy.context.scene["keep_this"] = "unchanged"
+    parent = live_preview.begin("Earlier preview", bpy.context)
+    result = local_glb.import_local_glb(bpy.context, "cube.glb")
+    assert result["ok"], result
+    assert result["preview_pending"]
+    imported_names = [item["name"] for item in result["created_data"] if item["kind"] == "object"]
+    assert imported_names and "Cube" not in imported_names, result
+    assert linked.library and linked.name == "Cube"
+    assert live_preview.current_transaction() is parent
+    assert len(bpy.data.objects) > len(before["objects"])
+    assert bpy.context.scene["keep_this"] == "unchanged"
+    rollback = live_preview.revert(bpy.context)
+    assert rollback["ok"], rollback
+    assert not rollback["rollback_warnings"], rollback
+    for _, collection in local_glb.DATA_KINDS:
+        assert {item.as_pointer() for item in getattr(bpy.data, collection)} == before[collection], collection
+    assert {item.name for item in bpy.context.selected_objects} == selected
+    assert bpy.context.view_layer.objects.active.name == active
+    from unittest import mock
+    parent = live_preview.begin("Earlier failure preview", bpy.context)
+    parent["applied_steps"].append({"label": "Earlier"})
+    importer = bpy.ops.import_scene.gltf
+    def fail_after_import(**kwargs):
+        assert importer(**kwargs) == {"FINISHED"}
+        material = bpy.data.materials.new("Partial material")
+        material.use_nodes = True
+        image = bpy.data.images.new("Partial image", 2, 2)
+        material.node_tree.nodes.new("ShaderNodeTexImage").image = image
+        raise RuntimeError("Injected failure after real import and image creation")
+    from types import SimpleNamespace
+    proxy = SimpleNamespace(data=bpy.data, ops=SimpleNamespace(import_scene=SimpleNamespace(gltf=fail_after_import)))
+    with mock.patch.object(local_glb, "bpy", proxy):
+        failed = local_glb.import_local_glb(bpy.context, "cube.glb")
+    assert not failed["ok"] and failed["rollback"]["ok"], failed
+    assert live_preview.current_transaction() is parent
+    assert parent["applied_steps"] == [{"label": "Earlier"}]
+    for _, collection in local_glb.DATA_KINDS:
+        assert {item.as_pointer() for item in getattr(bpy.data, collection)} == before[collection], collection
+    assert linked.library and linked.name == "Cube"
+print("LOCAL_GLB_SMOKE_OK")
