+"""Matched geometry evidence in a disposable scene, without source scene edits."""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import tempfile
+
+import bpy
+from mathutils import Vector
+
+from . import lab_parity
+
+
+def _targets(context, target):
+    kind, name = target["kind"], target["name"]
+    if kind not in ("OBJECT", "COLLECTION") or not isinstance(name, str) or not name:
+        raise ValueError("Supply an explicit OBJECT or COLLECTION name")
+    items = context.scene.objects if kind == "OBJECT" else bpy.data.collections
+    matches = [item for item in items if item.name == name]
+    if len(matches) != 1:
+        raise ValueError("Target must resolve to exactly one " + kind + ": " + name)
+    objects = [matches[0]] if kind == "OBJECT" else list(matches[0].all_objects)
+    if not objects or len(objects) > 256:
+        raise ValueError("Each target must contain 1 to 256 objects")
+    if any(obj.type != "MESH" or obj.name not in context.scene.objects for obj in objects):
+        raise ValueError("Targets must contain only mesh objects in the current scene")
+    if any(obj.instance_type != "NONE" or getattr(obj, "particle_systems", ()) for obj in objects):
+        raise ValueError("Instanced targets are not supported")
+    if any(obj.modifiers for obj in objects):
+        raise ValueError("Targets with modifiers are not supported; apply modifiers before capture to avoid viewport/render differences")
+    return sorted(objects, key=lambda obj: obj.name)
+
+
+def _validate(views, profile):
+    if not 1 <= len(views) <= 6:
+        raise ValueError("Supply 1 to 6 views")
+    for key in ("width", "height"):
+        if type(profile[key]) is not int or not 32 <= profile[key] <= 1024:
+            raise ValueError("Resolution must be 32 to 1024 pixels")
+    colour = profile["colour"]
+    if len(colour) != 3 or any(not math.isfinite(x) or not 0 <= x <= 1 for x in colour):
+        raise ValueError("Colour must contain three finite values from 0 to 1")
+    for view in views:
+        for key in ("position", "look_at"):
+            if len(view[key]) != 3 or any(not math.isfinite(x) or abs(x) > 100000 for x in view[key]):
+                raise ValueError("Camera coordinates must be finite and within 100000 units")
+        if view["position"] == view["look_at"]:
+            raise ValueError("Camera position and look_at must differ")
+        if view["projection"] not in ("PERSP", "ORTHO"):
+            raise ValueError("Unknown projection")
+        for key, low, high in (("lens", 1, 250), ("ortho_scale", 0.01, 10000)):
+            if not math.isfinite(view[key]) or not low <= view[key] <= high:
+                raise ValueError("Invalid camera " + key)
+
+
+def _render(scene, path):
+    scene.render.filepath = path
+    result = bpy.ops.render.render(write_still=True, scene=scene.name)
+    if result != {"FINISHED"}:
+        raise RuntimeError("The matched-view render did not finish")
+
+
+def capture_matched_views(context, baseline, candidate, views, profile):
+    try:
+        _validate(views, profile)
+        targets = {"baseline": _targets(context, baseline), "candidate": _targets(context, candidate)}
+        if {obj.as_pointer() for obj in targets["baseline"]} & {obj.as_pointer() for obj in targets["candidate"]}:
+            raise ValueError("Baseline and candidate must not overlap")
+    except (ValueError, KeyError, TypeError) as exc:
+        return {"ok": False, "code": "matched_views_invalid", "message": str(exc)}
+
+    owned = []
+    scene = None
+    directory = ""
+    def track(collection, item):
+        owned.append((collection, item))
+        return item
+    try:
+        root = lab_parity._render_root_info(context, create=True)["render_thumbnail_root"]
+        directory = tempfile.mkdtemp(prefix="matched-", dir=root)
+        scene = bpy.data.scenes.new("Matched views")
+        scene.render.engine = "CYCLES"
+        scene.cycles.device = "CPU"
+        scene.cycles.samples = 16
+        scene.cycles.seed = 0
+        scene.cycles.use_animated_seed = False
+        scene.cycles.use_denoising = False
+        scene.render.threads_mode = "FIXED"
+        scene.render.threads = 2
+        scene.render.resolution_x = profile["width"]
+        scene.render.resolution_y = profile["height"]
+        scene.render.resolution_percentage = 100
+        scene.render.image_settings.file_format = "PNG"
+        scene.render.image_settings.color_mode = "RGBA"
+        scene.render.image_settings.color_depth = "8"
+        scene.view_settings.view_transform = "Standard"
+        scene.view_settings.look = "None"
+        scene.view_settings.exposure = 0
+        scene.view_settings.gamma = 1
+        world = track(bpy.data.worlds, bpy.data.worlds.new("Matched world"))
+        world.use_nodes = True
+        world.node_tree.nodes.get("Background").inputs[0].default_value = (0.15, 0.15, 0.15, 1)
+        world.node_tree.nodes.get("Background").inputs[1].default_value = 0.8
+        scene.world = world
+        material = track(bpy.data.materials, bpy.data.materials.new("Matched material"))
+        material.use_nodes = True
+        shader = material.node_tree.nodes.get("Principled BSDF")
+        shader.inputs["Base Color"].default_value = (*profile["colour"], 1)
+        shader.inputs["Roughness"].default_value = 0.8
+        light_data = track(bpy.data.lights, bpy.data.lights.new("Matched sun", "SUN"))
+        light_data.energy = 3
+        light_data.angle = 0.1
+        light = track(bpy.data.objects, bpy.data.objects.new("Matched sun", light_data))
+        scene.collection.objects.link(light)
+        light.rotation_euler = (0.4, -0.6, -0.4)
+        camera_data = track(bpy.data.cameras, bpy.data.cameras.new("Matched camera"))
+        camera = track(bpy.data.objects, bpy.data.objects.new("Matched camera", camera_data))
+        scene.collection.objects.link(camera)
+        scene.camera = camera
+        camera_data.sensor_width = 36
+        camera_data.sensor_fit = "HORIZONTAL"
+        camera_data.clip_start = 0.01
+        camera_data.clip_end = 100000
+        copies = {}
+        depsgraph = context.evaluated_depsgraph_get()
+        for role, objects in targets.items():
+            copies[role] = []
+            for source in objects:
+                evaluated = source.evaluated_get(depsgraph)
+                mesh = track(bpy.data.meshes, bpy.data.meshes.new_from_object(evaluated, depsgraph=depsgraph))
+                mesh.materials.clear()
+                mesh.materials.append(material)
+                obj = track(bpy.data.objects, bpy.data.objects.new("Matched " + source.name, mesh))
+                scene.collection.objects.link(obj)
+                obj.matrix_world = evaluated.matrix_world.copy()
+                copies[role].append(obj)
+        manifest = {
+            "schema_version": 1, "blender_version": bpy.app.version_string,
+            "source_scene": context.scene.name, "source_frame": context.scene.frame_current,
+            "targets": {role: [obj.name for obj in objects] for role, objects in targets.items()},
+            "views": views, "profile": {**profile, "engine": "CYCLES", "samples": 16, "seed": 0,
+                "device": "CPU", "denoising": False, "resolution_percentage": 100,
+                "clip_start": 0.01, "clip_end": 100000, "png_colour_mode": "RGBA", "png_colour_depth": 8,
+                "lighting": {"world_colour": [0.15] * 3, "world_strength": 0.8, "sun_energy": 3,
+                    "sun_angle": 0.1, "sun_rotation": [0.4, -0.6, -0.4]},
+                "material_roughness": 0.8, "view_transform": "Standard", "look": "None",
+                "exposure": 0, "gamma": 1, "sensor_width": 36, "sensor_fit": "HORIZONTAL"},
+            "evidence_kind": "matched_geometry_comparison", "images": [],
+        }
+        for index, view in enumerate(views):
+            camera.location = view["position"]
+            camera.rotation_euler = (Vector(view["look_at"]) - camera.location).to_track_quat("-Z", "Y").to_euler()
+            camera_data.type = view["projection"]
+            camera_data.lens = view["lens"]
+            camera_data.ortho_scale = view["ortho_scale"]
+            for role in targets:
+                for group, objects in copies.items():
+                    for obj in objects:
+                        obj.hide_render = group != role
+                path = os.path.join(directory, f"{index:02d}-{role}.png")
+                _render(scene, path)
+                with open(path, "rb") as handle:
+                    digest = hashlib.sha256(handle.read()).hexdigest()
+                manifest["images"].append({"view_index": index, "role": role, "path": path, "sha256": digest})
+        path = os.path.join(directory, "manifest.json")
+        with open(path, "x", encoding="utf-8") as handle:
+            json.dump(manifest, handle, indent=2, allow_nan=False)
+        return {"ok": True, "manifest_path": path, "manifest": manifest}
+    except Exception as exc:
+        return {"ok": False, "code": "matched_views_failed", "message": str(exc), "partial_output_dir": directory}
+    finally:
+        if scene is not None:
+            bpy.data.scenes.remove(scene)
+        for collection, item in reversed(owned):
+            collection.remove(item, do_unlink=True)
+
+
+def register():
+    pass
+
+
+def unregister():
+    pass
