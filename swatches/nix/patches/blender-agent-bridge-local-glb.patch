+        (self.root / "folder.glb").mkdir()
+        for path in ("../model.glb", str(self.source), "link.glb", "linked/model.glb", ".hidden.glb", "folder.glb", "missing.glb", "model.gltf"):
+            with self.subTest(path=path):
+                self.assertFalse(self.module.import_local_glb(self.context, path)["ok"])
