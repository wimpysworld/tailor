+def _open_directory(path):
+    if (os.name != "posix" or any(not hasattr(os, flag) for flag in
+            ("O_NOFOLLOW", "O_DIRECTORY", "O_NONBLOCK"))
+            or os.open not in os.supports_dir_fd):
+        raise ValueError("Safe local GLB reads are unavailable on this platform")
+    if not isinstance(path, str) or not path.startswith("/") or path.startswith("//"):
+        raise ValueError("An absolute import directory is required")
+    parts = path.rstrip("/").split("/")[1:]
+    if not parts or any(not part or part.startswith(".") or "\\" in part for part in parts):
+        raise ValueError("Invalid import directory")
