+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "addon"))
+from claude_blender import tool_registry
+
+
+def load_module(name):
+    spec = importlib.util.spec_from_file_location("claude_blender." + name, ROOT / "addon/claude_blender" / (name + ".py"))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def glb(document=None):
+    payload = json.dumps(document or {"asset": {"version": "2.0"}}).encode()
+    payload += b" " * (-len(payload) % 4)
+    return struct.pack("<4sIIII", b"glTF", 2, 20 + len(payload), len(payload), 0x4E4F534A) + payload
+
+
+class Collection(list):
+    active = None
+
+    def get(self, name):
+        return next((item for item in self if item.name == name), None)
+
+    def remove(self, item, **kwargs):
+        super().remove(item)
+
+
+class Item:
+    def __init__(self, name):
+        self.name = name
+        self.users = 0
+        self.selected = False
+
+    def as_pointer(self):
+        return id(self)
+
+    def select_set(self, value):
+        self.selected = value
+
+
+class LocalGlbTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(dir=ROOT)
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.bpy = types.ModuleType("bpy")
+        handlers = types.ModuleType("bpy.app.handlers")
+        handlers.persistent = lambda function: function
+        handlers.load_post = []
+        self.bpy.app = types.SimpleNamespace(handlers=handlers)
+        self.bpy.data = types.SimpleNamespace(filepath=str(self.root / "scene.blend"))
+        self.bpy.ops = types.SimpleNamespace(import_scene=types.SimpleNamespace(gltf=mock.Mock(return_value={"FINISHED"})))
+        modules = {
+            "bpy": self.bpy, "bpy.app.handlers": handlers,
+            "mathutils": types.SimpleNamespace(Matrix=mock.Mock()),
+            "claude_blender.lab_parity": types.ModuleType("lab_parity"),
+            "claude_blender.script_runner": types.ModuleType("script_runner"),
+        }
+        with mock.patch.dict(sys.modules, modules):
+            self.preview = load_module("live_preview")
+            self.files = load_module("project_files")
+            import claude_blender
+            with mock.patch.object(claude_blender, "live_preview", self.preview, create=True), mock.patch.object(claude_blender, "project_files", self.files, create=True):
+                self.module = load_module("local_glb")
+        for _, collection in self.module.DATA_KINDS:
+            setattr(self.bpy.data, collection, Collection())
+        self.old = Item("Existing")
+        self.old.selected = True
+        self.bpy.data.objects.append(self.old)
+        self.bpy.data.objects.active = self.old
+        self.context = types.SimpleNamespace(
+            mode="OBJECT", scene=types.SimpleNamespace(name="Scene"),
+            view_layer=types.SimpleNamespace(objects=self.bpy.data.objects, update=lambda: None),
+            selected_objects=[self.old], screen=None,
+        )
+        self.prefs = types.SimpleNamespace(local_glb_import_root="")
+        self.context.preferences = types.SimpleNamespace(addons={
+            "claude_blender": types.SimpleNamespace(preferences=self.prefs),
+        })
+        self.bpy.context = self.context
+        self.source = self.root / "model.glb"
+        self.source.write_bytes(glb())
+
+    def test_registry_discovery(self):
+        spec = tool_registry.REGISTRY.get("import_local_glb")
+        self.assertEqual(spec.owner, "external_assets")
+        self.assertEqual(spec.exposure, "catalog")
+        self.assertEqual(spec.input_schema["required"], ["relative_path"])
+        self.assertTrue(spec.contract["requires_live_preview"])
+        self.assertIn("files:read", spec.contract["permissions"])
+        self.assertIn("import_local_glb", {item["name"] for item in tool_registry.definitions()})
+
+    def test_path_rejections_leave_preview_unchanged(self):
+        parent = self.preview.begin("Earlier", self.context)
+        (self.root / "link.glb").symlink_to(self.source)
